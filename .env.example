# ---- Database (local Docker Postgres for dev; Supabase for hosted) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codesync"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/codesync"
# When using Supabase, DATABASE_URL = pooled (port 6543), DIRECT_URL = direct (port 5432)

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Qdrant ----
QDRANT_URL="http://localhost:6333"

# ---- Auth (Clerk) ----
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

# ---- AI service ----
OPENAI_API_KEY=""
AI_SERVICE_URL="http://localhost:8000"

# ---- Service ports ----
API_PORT=4000
SYNC_PORT=4001
WORKER_CONCURRENCY=4

# ---- Limits (see design doc section 3.1 / 3.2) ----
EXECUTION_TIMEOUT_MS=5000
EXECUTION_RAM_MB=256
EXECUTION_RATE_PER_MIN=10
AI_DAILY_LIMIT_PER_USER=50
